# Production environment variables (example)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_STARTER=price_xxx
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_PRO=price_yyy
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ENTERPRISE=price_zzz

# App
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app
NEXT_PUBLIC_APP_NAME=Qupid
PAYMENT_FEE_PERCENT=2.5
ADMIN_API_KEY=replace_with_a_strong_key

# Bank details
BANK_IM_ACCOUNT_NAME="Qupid Ltd - I&M"
BANK_IM_ACCOUNT_NUMBER=1234567890
BANK_IM_TILL_NUMBER=800800
BANK_KCB_ACCOUNT_NAME="Qupid Ltd - KCB"
BANK_KCB_ACCOUNT_NUMBER=0987654321
BANK_KCB_TILL_NUMBER=700700
BANK_PAYMENT_REFERENCE_PREFIX=QUPID

# SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=no-reply@qupid.app

NODE_ENV=production
