# Supabase + Stripe environment example
# Frontend URL
NEXT_PUBLIC_APP_NAME=Qupid
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Payment fee percentage taken from each transaction (example: 2.5 means 2.5%)
PAYMENT_FEE_PERCENT=2.5

# Bank details (I&M and KCB) — replace with real values
BANK_IM_ACCOUNT_NAME="Qupid Ltd - I&M"
BANK_IM_ACCOUNT_NUMBER=1234567890
BANK_IM_TILL_NUMBER=800800

BANK_KCB_ACCOUNT_NAME="Qupid Ltd - KCB"
BANK_KCB_ACCOUNT_NUMBER=0987654321
BANK_KCB_TILL_NUMBER=700700

BANK_PAYMENT_REFERENCE_PREFIX=QUPID

# Storage (optional) - Supabase storage will be used for receipts
# No secrets needed for client uploads if you use signed uploads. For server-side processing, use SERVICE_ROLE_KEY above.

NODE_ENV=development
